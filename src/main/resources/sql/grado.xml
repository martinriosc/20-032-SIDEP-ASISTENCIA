<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cl.mineduc.sidep.asistenciaapi.mappers.GradoMapper">

    <resultMap id="gradoResultMap" type="cl.mineduc.sidep.asistenciaapi.model.GradoModel">
        <id property="id" column="pk_grad_id_grado" />
        <result property="nombre" column="grad_nombre" />
        <result property="fechaCreacion" column="grad_fecha_creacion" />
        <result property="fechaActualizacion" column="grad_fecha_actualizacion" />

        <!-- Asociación a unidad_educativa -->
        <association property="unidadEducativa" javaType="cl.mineduc.sidep.asistenciaapi.model.UnidadEducativaModel">
            <id property="id" column="pk_uned_id_unidad_educativa"/>
            <result property="nombre" column="uned_nombre"/>
        </association>
    </resultMap>

    <sql id="selectGrado">
        SELECT
            gr.pk_grad_id_grado,
            gr.grad_nombre,
            gr.grad_fecha_creacion,
            gr.grad_fecha_actualizacion,

            ue.pk_uned_id_unidad_educativa,
            ue.uned_nombre
        FROM grado gr
                 LEFT JOIN unidad_educativa ue ON ue.pk_uned_id_unidad_educativa = gr.fk_grad_id_unidad_educativa
    </sql>

    <insert id="insert" parameterType="cl.mineduc.sidep.asistenciaapi.entities.GradoEntity"
            useGeneratedKeys="true" keyProperty="id" keyColumn="pk_grad_id_grado">
        INSERT INTO grado
        (
            fk_grad_id_unidad_educativa,
            grad_nombre,
            grad_fecha_creacion
        )
        VALUES
            (
                #{unidadEducativa},
                #{nombre},
                CURRENT_TIMESTAMP
            )
    </insert>

    <update id="update" parameterType="cl.mineduc.sidep.asistenciaapi.entities.GradoEntity">
        UPDATE grado
        SET
            fk_grad_id_unidad_educativa = #{unidadEducativa},
            grad_nombre = #{nombre},
            grad_fecha_actualizacion = CURRENT_TIMESTAMP
        WHERE pk_grad_id_grado = #{id}
    </update>

    <delete id="delete" parameterType="java.lang.Long">
        DELETE FROM grado
        WHERE pk_grad_id_grado = #{id}
    </delete>

    <select id="findAll" resultMap="gradoResultMap" parameterType="cl.mineduc.sidep.asistenciaapi.filter.GradoFilter">
        <include refid="selectGrado"/>
        WHERE 1=1
        <if test="nombre != null">
            AND UPPER(gr.grad_nombre) LIKE UPPER(#{nombre})
        </if>
        <if test="orderBy != null">
            ORDER BY #{orderBy} ${order}
        </if>
        <if test="limit != null">
            LIMIT #{limit} OFFSET #{offset}
        </if>
    </select>

    <select id="countTotal" resultType="java.lang.Long" parameterType="cl.mineduc.sidep.asistenciaapi.filter.GradoFilter">
        SELECT COUNT(gr.pk_grad_id_grado)
        FROM grado gr
        LEFT JOIN unidad_educativa ue ON ue.pk_uned_id_unidad_educativa = gr.fk_grad_id_unidad_educativa
        WHERE 1=1
        <if test="nombre != null">
            AND UPPER(gr.grad_nombre) LIKE UPPER(#{nombre})
        </if>
    </select>

    <select id="findById" resultMap="gradoResultMap" parameterType="java.lang.Long">
        <include refid="selectGrado"/>
        WHERE gr.pk_grad_id_grado = #{id}
    </select>

</mapper>
